generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADVOCATE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases    Case[]
  hearings Hearing[]

  @@index([email])
  @@map("users")
}

model Case {
  id           String    @id @default(cuid())
  title        String
  caseNumber   String    @unique
  court        String?
  judgmentDate DateTime?
  caseType     String?
  status       String    @default("PENDING")

  extractedText String?

  pdfUrl      String?
  pdfFileName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents  Document[]
  summary    Summary?
  citations  Citation[]
  hearings   Hearing[]
  embeddings CaseEmbedding[]

  @@index([userId])
  @@index([status])
  @@index([caseNumber])
  @@map("cases")
}

model Document {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  fileName      String
  fileSize      Int?
  mimeType      String?
  storagePath   String
  extractedText String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("documents")
}

model Summary {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  briefFacts   String?
  issuesRaised String?
  arguments    String?
  judgment     String?
  keyPoints    String?

  embedding String?

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  model       String   @default("gemini-1.5-flash")

  @@map("summaries")
}

model Citation {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  citation String
  type     String?
  context  String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("citations")
}

model Hearing {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date     DateTime
  time     String?
  location String?
  notes    String?
  status   String   @default("SCHEDULED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([userId])
  @@index([date])
  @@map("hearings")
}

model CaseEmbedding {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  chunkIndex Int
  chunkText  String
  vector     String

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("case_embeddings")
}

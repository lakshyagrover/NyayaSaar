# ─── Database (SQLite) ───────────────────────────────────────────────────────
# Postgres database (from Vercel -> Storage -> Neon). Example:
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret-string"

# --- Groq AI ---
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_SAFE_TPM=6500

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# --- File storage (Vercel Blob) - set automatically when you connect Blob on Vercel ---
# BLOB_READ_WRITE_TOKEN=""

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="AI Court Summarizer"
